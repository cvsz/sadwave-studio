# SadwaveStudio runtime configuration example
# Never commit real credentials or secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Safety defaults
DRY_RUN=true
AUTONOMY_LEVEL=0
COST_LOCK=true

# Provider budgets; zero means no paid spend is permitted until explicitly changed.
MAX_DAILY_API_COST=0
MAX_MONTHLY_API_COST=0
MAX_AI_TOKENS=0
MAX_RENDER_TIME_SECONDS=0

# Provider selection must be explicit. Do not silently fall back to paid providers.
AI_PROVIDER_MODE=local
